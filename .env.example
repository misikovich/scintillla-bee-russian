# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=
# CLIProxyAPI address and client key (for cliproxy/* models)
CLIPROXY_BASE_URL=http://<host>:8317/v1
CLIPROXY_API_KEY=
# Satellite web search (config.yaml `satellite.search`): https://app.tavily.com or https://dashboard.exa.ai
TAVILY_API_KEY=
EXA_API_KEY=
# Image generation (config.yaml `imagegen`): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
