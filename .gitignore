# This gitignore is a whitelist. Inspired by https://rgbcu.be/blog/gitignore

*

!.gitignore

!*.md
!*.py
!viewer.html

!Dockerfile
!config.yaml
!docker-compose.yaml
!searxng/
!searxng/settings.yml
!docs/
!docs/*.svg
!sounds/
!sounds/*.mp3
!sounds/*.ogg
!sounds/*.json
!requirements.txt
!.env.example
